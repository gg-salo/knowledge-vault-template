{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/qmd-refresh.sh",
            "timeout": 10,
            "statusMessage": "Refreshing vault index in background (skips if QMD not installed)..."
          }
        ]
      }
    ]
  }
}
